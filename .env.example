# ==============================================================================
# BudgetWise AI - Environment Variables Template
# ==============================================================================
# Copy this file to .env and provide your actual local configurations:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# IMPORTANT: Never commit your actual .env file or API keys to version control.
# ==============================================================================

# OpenAI API Configuration
# Configurable OpenAI model (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (defaults to local SQLite database in data/ directory)
DATABASE_PATH=data/budgetwise.db

# Currency Setting (defaults to INR)
DEFAULT_CURRENCY=INR

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Expense Categorizer Configuration
# Minimum confidence threshold (0.0 to 1.0) before categorizer falls back to asking clarification
CATEGORIZER_CONFIDENCE_THRESHOLD=0.70

# Budget Thresholds
BUDGET_WARNING_THRESHOLD=0.80
BUDGET_CRITICAL_THRESHOLD=1.00
